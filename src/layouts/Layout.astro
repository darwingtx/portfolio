---
import '../styles/global.css';
import { getContent, getLang } from '../data/profile';

const lang = getLang(Astro.currentLocale);
const { meta, profile } = getContent(lang);
const title = meta.title;
const description = profile.summary;
const site = Astro.site ?? Astro.url;
const canonical = Astro.url.href;
const ogImage = new URL('/og.png', site).href;
const fontStylesheet =
  'https://fonts.googleapis.com/css2?family=Bangers&family=Comic+Neue:wght@400;700&display=swap';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL('/', site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Darwin Castaño" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- media="print" + onload: la hoja de fuentes no bloquea el primer render -->
    <link href={fontStylesheet} rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href={fontStylesheet} rel="stylesheet" />
    </noscript>
  </head>
  <body class="overflow-x-hidden">
    <slot />
    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
