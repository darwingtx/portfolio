---
import SpiderWeb from './SpiderWeb.astro';
import SectionTitle from './SectionTitle.astro';
import { getContent } from '../data/profile';
const { experience, ui } = getContent(Astro.currentLocale);
---
<section id="experience" class="relative mx-auto max-w-6xl px-4 py-24">
  <SpiderWeb class="section-web absolute -z-10 max-w-none top-1/4 left-0 w-[36rem] -translate-x-1/2 text-steel/40" seed={5} spokes={14} rings={8} />
  <SpiderWeb class="section-web absolute -z-10 max-w-none top-10 right-0 w-36 translate-x-1/4 text-blood/40" size={300} seed={73} spokes={8} rings={4} />
  <SpiderWeb class="section-web absolute -z-10 max-w-none -bottom-10 right-0 w-[20rem] translate-x-1/3 text-crimson/60" seed={81} spokes={10} rings={5} />
  <SectionTitle kicker={ui.kickers.experience} title={ui.titles.experience} />
  <ol class="relative space-y-10 border-l-2 border-dashed border-pink/60 pl-8">
    {experience.map((job) => (
      <li class="reveal relative">
        <span class="absolute top-2 -left-[2.6rem] size-4 rotate-45 bg-cyan"></span>
        <p class="font-label text-sm text-yellow">{job.period} · {job.place}</p>
        <h3 class="font-display text-3xl tracking-wide">
          {job.role} <span class="text-pink">@ {job.company}</span>
        </h3>
        <ul class="mt-3 list-['▸_'] space-y-1 pl-5 text-paper/80 marker:text-cyan">
          {job.points.map((p) => <li>{p}</li>)}
        </ul>
      </li>
    ))}
  </ol>
</section>
