---
import SectionTitle from './SectionTitle.astro';
import SpiderWeb from './SpiderWeb.astro';
import { getContent } from '../data/profile';
const { experience, ui } = getContent(Astro.currentLocale);
---
<section id="experience" class="relative mx-auto max-w-6xl px-4 py-24">
  <SpiderWeb class="absolute -z-10 max-w-none top-1/3 left-0 w-[30rem] -translate-x-3/4 text-ink/25" seed={5} spokes={11} rings={6} />
  <SectionTitle title={ui.titles.experience} />
  <div class="timeline relative">
  <span aria-hidden="true" class="timeline-line absolute top-0 left-0 h-full w-0.5 origin-top bg-ink"></span>
  <ol class="space-y-12 pl-8">
    {experience.map((job) => (
      <li class="reveal relative">
        <span class="job-dot absolute top-2 -left-[2.55rem] size-3.5 rotate-45 bg-red"></span>
        <p class="font-label text-sm text-muted">{job.period} · {job.place}</p>
        <h3 class="font-display text-3xl tracking-wide">
          {job.role} <span class="text-red">@ {job.company}</span>
        </h3>
        <ul class="mt-3 max-w-[70ch] list-[square] space-y-1 pl-5 text-muted marker:text-red">
          {job.points.map((p) => <li>{p}</li>)}
        </ul>
      </li>
    ))}
  </ol>
  </div>
</section>
