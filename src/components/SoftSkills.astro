---
import SectionTitle from './SectionTitle.astro';
import SpiderWeb from './SpiderWeb.astro';
import { getContent } from '../data/profile';
const { softSkills, ui } = getContent(Astro.currentLocale);
---
<section id="soft" class="relative mx-auto max-w-6xl px-4 py-24">
  <SpiderWeb class="section-web absolute -z-10 max-w-none top-0 right-0 w-[22rem] translate-x-1/3 text-crimson/60" seed={67} spokes={10} rings={5} />
  <SpiderWeb class="section-web absolute -z-10 max-w-none top-1/2 left-1/2 w-28 text-steel/40" size={300} seed={23} spokes={7} rings={3} />
  <SpiderWeb class="section-web absolute -z-10 -bottom-20 left-0 w-[32rem] max-w-none -translate-x-1/3 text-blood/55" seed={53} spokes={10} rings={5} />
  <SectionTitle kicker={ui.kickers.soft} title={ui.titles.soft} />
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {softSkills.map(({ title, evidence }) => (
      <div class="reveal border-l-4 border-pink bg-ink/80 p-5">
        <h3 class="font-display text-2xl tracking-wide text-cyan">{title}</h3>
        <p class="mt-3 text-paper/70">{evidence}</p>
      </div>
    ))}
  </div>
</section>
