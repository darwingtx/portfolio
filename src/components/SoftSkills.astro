---
import SectionTitle from './SectionTitle.astro';
import SpiderWeb from './SpiderWeb.astro';
import { getContent } from '../data/profile';
const { softSkills, ui } = getContent(Astro.currentLocale);
---
<section id="soft" class="relative mx-auto max-w-6xl px-4 py-24">
  <SpiderWeb class="absolute -z-10 max-w-none -top-10 right-0 w-[22rem] translate-x-1/3 text-ink/25" seed={67} spokes={11} rings={6} />
  <SectionTitle title={ui.titles.soft} />
  <div class="grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {softSkills.map(({ title, evidence }) => (
      <div class="reveal">
        <h3 class="font-display text-2xl tracking-wide"><span aria-hidden="true" class="mr-2 inline-block size-2.5 rotate-45 bg-red align-middle"></span>{title}</h3>
        <p class="mt-2 leading-relaxed text-muted">{evidence}</p>
      </div>
    ))}
  </div>
</section>
