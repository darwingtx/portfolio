---
import SectionTitle from './SectionTitle.astro';
import SpiderWeb from './SpiderWeb.astro';
import { getContent } from '../data/profile';
const { projects, ui } = getContent(Astro.currentLocale);

// Clases completas para que Tailwind las detecte.
const accents = {
  pink: { shadow: 'shadow-[10px_10px_0_var(--color-pink)]', text: 'text-pink', bg: 'bg-pink' },
  cyan: { shadow: 'shadow-[10px_10px_0_var(--color-cyan)]', text: 'text-cyan', bg: 'bg-cyan' },
  violet: { shadow: 'shadow-[10px_10px_0_var(--color-violet)]', text: 'text-violet', bg: 'bg-violet' },
  yellow: { shadow: 'shadow-[10px_10px_0_var(--color-yellow)]', text: 'text-yellow', bg: 'bg-yellow' },
};
---
<section id="projects" class="relative mx-auto max-w-6xl px-4 py-24">
  <SpiderWeb class="section-web absolute -z-10 top-0 right-0 w-[38rem] max-w-none translate-x-1/2 text-crimson/70" seed={42} spokes={12} rings={7} />
  <SpiderWeb class="section-web absolute -z-10 bottom-40 left-0 w-[36rem] max-w-none -translate-x-1/2 text-steel/40" seed={17} spokes={10} rings={7} />
  <SectionTitle kicker={ui.kickers.projects} title={ui.titles.projects} />
  <div class="space-y-14">
    {projects.map((p, i) => {
      const a = accents[p.accent];
      return (
        <article class={`project-card relative grid border-3 border-paper bg-[linear-gradient(135deg,var(--color-ink)_35%,var(--color-night))] md:grid-cols-[1fr_1.4fr] ${a.shadow}`}>
          <div class="halftone pointer-events-none absolute inset-0 text-paper/5"></div>

          <header class={`relative flex flex-col gap-4 border-b-3 border-paper p-6 md:border-r-3 md:border-b-0 ${i % 2 ? 'md:order-2 md:border-r-0 md:border-l-3' : ''}`}>
            <div class="flex items-start justify-between gap-4 font-label text-xs tracking-wider uppercase">
              <span class={a.text}>{p.tag}</span>
              <span class="text-paper/50">{p.year.endsWith('–') ? `${p.year} ${ui.present}` : p.year}</span>
            </div>
            <h3 class="font-display text-5xl leading-none tracking-wide">{p.title}</h3>
            <ul class="flex flex-wrap gap-2">
              {p.stack.map((s) => <li class="border border-paper/30 px-2 py-0.5 font-label text-xs tracking-wide">{s}</li>)}
            </ul>
            {p.links.length > 0 && (
              <div class="mt-auto flex flex-wrap gap-3 pt-2">
                {p.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener" class={`${a.bg} px-3 py-1 font-display text-lg tracking-wide text-ink transition-transform hover:-translate-y-0.5 ${p.accent === 'violet' ? 'text-paper' : ''}`}>
                    {l.label} →
                  </a>
                ))}
              </div>
            )}
          </header>

          <div class="relative space-y-6 p-6">
            <div>
              <p class="inline-block -rotate-1 bg-yellow px-2 py-0.5 font-display text-xl tracking-wide text-ink">{ui.problem}</p>
              <p class="mt-3 text-lg leading-relaxed text-paper/90">{p.problem}</p>
            </div>
            <div>
              <p class="inline-block rotate-1 bg-cyan px-2 py-0.5 font-display text-xl tracking-wide text-ink">{ui.solution}</p>
              <ul class="mt-3 list-['▸_'] space-y-2 pl-5 text-paper/80 marker:text-pink">
                {p.solution.map((s) => <li>{s}</li>)}
              </ul>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>
