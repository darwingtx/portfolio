---
import SectionTitle from './SectionTitle.astro';
import SpiderWeb from './SpiderWeb.astro';
import { getContent } from '../data/profile';
const { projects, ui } = getContent(Astro.currentLocale);

// Cada proyecto es otro universo: su color va en la sombra de la viñeta y en la onomatopeya.
// Clases completas para que Tailwind las detecte.
const accents = {
  pink: { shadow: 'shadow-[8px_8px_0_var(--color-pink)]', text: 'text-pink', bg: 'bg-pink text-coal' },
  cyan: { shadow: 'shadow-[8px_8px_0_var(--color-cyan)]', text: 'text-cyan', bg: 'bg-cyan text-coal' },
  violet: { shadow: 'shadow-[8px_8px_0_var(--color-violet)]', text: 'text-violet', bg: 'bg-violet text-white' },
  yellow: { shadow: 'shadow-[8px_8px_0_var(--color-yellow)]', text: 'text-yellow', bg: 'bg-yellow text-coal' },
};
---
<section id="projects" class="relative mx-auto max-w-6xl px-4 py-24">
  <SpiderWeb class="absolute -z-10 max-w-none -top-16 right-0 w-[32rem] translate-x-1/2 text-ink/25" seed={42} spokes={11} rings={6} />
  <SectionTitle title={ui.titles.projects} />
  <div class="space-y-14">
    {projects.map((p, i) => {
      const a = accents[p.accent];
      return (
        <article class={`project-card relative grid border-2 border-ink bg-card md:grid-cols-[1fr_1.4fr] ${a.shadow}`}>
          <span aria-hidden="true" class={`sfx sfx-text pointer-events-none absolute -top-6 right-6 z-10 font-display text-4xl tracking-wide ${i % 2 ? '-rotate-6' : 'rotate-6'} ${a.text}`}>{p.sfx}</span>

          <header class="flex min-w-0 flex-col gap-4 border-b-2 border-ink p-6 md:border-r-2 md:border-b-0">
            <div class="flex items-start justify-between gap-4 font-label text-sm tracking-wider text-muted uppercase">
              <span>{p.tag}</span>
              <span>{p.year.endsWith('–') ? `${p.year} ${ui.present}` : p.year}</span>
            </div>
            <h3 class="font-display text-4xl leading-none tracking-wide hyphens-auto break-words sm:text-5xl">{p.title}</h3>
            <ul class="flex flex-wrap gap-2">
              {p.stack.map((s) => <li class="border border-line bg-paper px-2 py-0.5 font-label text-base">{s}</li>)}
            </ul>
            <div>
              <p class="inline-block -rotate-1 bg-yellow px-2 py-0.5 font-display text-xl tracking-wide text-coal">{ui.problem}</p>
              <p class="mt-3 text-xl leading-relaxed font-bold">{p.problem}</p>
            </div>
            {p.links.length > 0 && (
              <div class="mt-auto flex flex-wrap gap-3 pt-2">
                {p.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener" class={`${a.bg} border-2 border-ink px-3 py-1 font-display text-lg tracking-wide transition-transform hover:-translate-y-0.5`}>
                    {l.label} →
                  </a>
                ))}
              </div>
            )}
          </header>

          <div class="p-6">
            <p class="inline-block rotate-1 bg-ink px-2 py-0.5 font-display text-xl tracking-wide text-paper">{ui.solution}</p>
            <ul class="mt-3 list-[square] space-y-2.5 pl-5 text-muted marker:text-red">
              {p.solution.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        </article>
      );
    })}
  </div>
</section>
