---
interface Props { title: string }
const { title } = Astro.props;
---
<header class="mb-12 flex items-end gap-6">
  <h2 class="section-title misprint font-display text-5xl tracking-wide md:text-6xl">{title}</h2>
  <span aria-hidden="true" class="title-rule mb-3 h-0.5 flex-1 origin-left bg-ink"></span>
</header>
