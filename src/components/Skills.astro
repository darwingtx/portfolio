---
import SectionTitle from './SectionTitle.astro';
import SpiderWeb from './SpiderWeb.astro';
import { getContent } from '../data/profile';
const { skills, ui } = getContent(Astro.currentLocale);
---
<section id="skills" class="relative mx-auto max-w-6xl px-4 py-24">
  <SpiderWeb class="section-web absolute -z-10 -bottom-20 right-0 w-[32rem] max-w-none translate-x-1/3 text-blood/55" seed={29} spokes={12} rings={6} />
  <SectionTitle kicker={ui.kickers.skills} title={ui.titles.skills} />
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {skills.map(([group, items]) => (
      <div class="reveal border-l-4 border-pink bg-ink/80 p-5">
        <h3 class="font-display text-2xl tracking-wide text-cyan">{group}</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {items.map((s) => (
            <li class="skill-chip bg-paper px-2 py-1 font-label text-xs text-ink">{s}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
