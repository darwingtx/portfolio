---
import SectionTitle from './SectionTitle.astro';
import SpiderWeb from './SpiderWeb.astro';
import { getContent } from '../data/profile';
const { skills, ui } = getContent(Astro.currentLocale);
---
<section id="skills" class="relative mx-auto max-w-6xl px-4 py-24">
  <SpiderWeb class="absolute -z-10 max-w-none -bottom-16 left-0 w-[26rem] -translate-x-1/2 text-red/35" seed={29} spokes={11} rings={6} />
  <SectionTitle title={ui.titles.skills} />
  <dl class="divide-y divide-line border-y border-line">
    {skills.map(([group, items]) => (
      <div class="skill-row grid gap-3 py-5 md:grid-cols-[14rem_1fr] md:items-baseline">
        <dt class="font-display text-2xl tracking-wide">{group}</dt>
        <dd class="flex flex-wrap gap-2">
          {items.map((s) => (
            <span class="skill-chip border border-ink bg-card px-2 py-1 font-label text-base">{s}</span>
          ))}
        </dd>
      </div>
    ))}
  </dl>
</section>
