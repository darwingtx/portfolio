---
import SpiderWeb from './SpiderWeb.astro';
import { getContent } from '../data/profile';
const { profile, ui } = getContent(Astro.currentLocale);
---
<section id="home" class="relative flex min-h-svh items-center overflow-hidden px-4 pt-20">
  <SpiderWeb class="hero-web absolute -top-40 -right-40 w-[46rem] max-w-none text-blood/45" seed={7} spokes={13} />
  <SpiderWeb class="hero-web absolute -bottom-52 -left-52 w-[34rem] max-w-none text-steel/40" spokes={10} rings={6} seed={21} />
  <div class="halftone absolute inset-0 text-steel/10 [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>

  <div class="relative mx-auto grid w-full max-w-6xl items-center gap-10 md:grid-cols-[1.2fr_1fr]">
    <div>
      <div class="name-tag relative z-20 inline-block w-full max-w-md -rotate-3 rounded-2xl bg-red pt-2 pb-5 shadow-[10px_10px_0_var(--color-ink)]">
        <p class="text-center leading-none font-sans font-bold text-white">
          <span class="block text-5xl tracking-tight md:text-6xl">{ui.hello}</span>
          <span class="block text-lg md:text-xl">{ui.myNameIs}</span>
        </p>
        <h1 class="relative mt-3 bg-white px-4 py-5 text-center font-hand text-5xl leading-none text-ink md:text-6xl" aria-label={profile.name}>
          <span aria-hidden="true">
            {profile.name.split(' ').map((word, i) => (
              <>{i > 0 && ' '}<span class="inline-block whitespace-nowrap">{[...word].map((ch) => <span class="name-char inline-block">{ch}</span>)}</span></>
            ))}
          </span>
          <!-- Lata de spray: la boquilla está en (52,17) px del tamaño mostrado (97x120) -->
          <img src="/spray-can.webp" alt="" aria-hidden="true" width="97" height="120" class="spray-can pointer-events-none absolute top-0 left-0 z-10 max-w-none opacity-0 drop-shadow-[4px_4px_0_var(--color-ink)]" />
        </h1>
      </div>
      <p class="hero-item mt-4 inline-block -rotate-1 bg-yellow px-3 py-1 font-display text-2xl tracking-wide text-ink md:text-3xl">
        {profile.role}
      </p>
      <p class="hero-item mt-6 max-w-xl text-lg text-paper/80">{profile.summary}</p>
      <div class="hero-item mt-8 flex flex-wrap gap-4">
        <a href="#projects" class="comic-panel bg-pink px-6 py-3 font-display text-xl tracking-wide text-ink transition-transform hover:-translate-y-1">
          {ui.seeProjects}
        </a>
        <a href={profile.github} target="_blank" rel="noopener" class="border-3 border-cyan px-6 py-3 font-display text-xl tracking-wide text-cyan transition-colors hover:bg-cyan hover:text-ink">
          GitHub
        </a>
      </div>
    </div>

    <div class="hero-item relative mx-auto w-72 sm:w-80 md:w-[26rem]">
      <div class="absolute inset-0 translate-x-3 translate-y-3 bg-cyan"></div>
      <div class="absolute inset-0 -translate-x-3 -translate-y-3 bg-pink"></div>
      <img src={`${profile.avatar}&s=640`} alt={ui.photoAlt} width="416" height="416" class="relative aspect-square w-full border-3 border-paper object-cover grayscale contrast-125" />
      <span class="burst absolute -top-8 -right-8 rotate-12 bg-yellow px-3 py-1 font-display text-3xl text-ink">DEPLOY!</span>
    </div>
  </div>
</section>
