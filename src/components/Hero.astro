---
import SpiderWeb from './SpiderWeb.astro';
import BrandIcon from './BrandIcon.astro';
import { getContent } from '../data/profile';
const { profile, ui } = getContent(Astro.currentLocale);
---
<section id="home" class="relative flex min-h-svh items-center overflow-hidden px-4 pt-20">
  <SpiderWeb class="hero-web absolute -top-40 -right-40 w-[48rem] max-w-none text-ink/45" seed={7} spokes={13} />
  <SpiderWeb class="hero-web absolute -bottom-32 -left-32 w-[24rem] max-w-none text-red/60" seed={21} spokes={10} rings={5} />
  <div class="halftone absolute inset-y-0 right-0 w-1/2 text-red/15 [mask-image:radial-gradient(circle_at_70%_40%,black,transparent_65%)]"></div>

  <div class="relative mx-auto grid w-full max-w-6xl items-center gap-12 md:grid-cols-[1.2fr_1fr]">
    <div>
      <div class="name-tag relative z-20 inline-block w-full max-w-md -rotate-3 rounded-2xl bg-red pt-2 pb-5 shadow-[8px_8px_0_var(--color-ink)]">
        <p class="text-center leading-none font-sans font-bold text-white">
          <span class="block text-5xl tracking-tight md:text-6xl">{ui.hello}</span>
          <span class="block text-xl">{ui.myNameIs}</span>
        </p>
        <h1 class="relative mt-3 w-full max-w-md overflow-hidden bg-white px-4 py-5 text-center font-hand text-5xl leading-none text-coal md:overflow-visible md:text-6xl" aria-label={profile.name}>
          <span aria-hidden="true">
            {profile.name.split(' ').map((word, i) => (
              <>{i > 0 && ' '}<span class="inline-block whitespace-nowrap">{[...word].map((ch) => <span class="name-char inline-block">{ch}</span>)}</span></>
            ))}
          </span>
          <!-- Lata de spray: la boquilla está en (52,17) px del tamaño de referencia (97x120) -->
          <img src="/spray-can.webp" alt="" aria-hidden="true" class="spray-can pointer-events-none absolute top-0 left-0 z-10 h-auto w-[clamp(64px,18vw,97px)] max-w-none opacity-0 drop-shadow-[3px_3px_0_var(--color-ink)]" />
        </h1>
      </div>
      <p class="hero-role mt-5 inline-block -rotate-1 bg-yellow px-3 py-1 font-display text-2xl tracking-wide text-coal md:text-3xl">
        {profile.role}
      </p>
      <p class="hero-item mt-6 max-w-xl text-lg leading-relaxed text-muted">{profile.summary}</p>
      <div class="hero-item mt-8 flex flex-wrap items-center gap-3">
        <a href="#projects" class="comic-panel bg-red px-6 py-3 font-display text-xl tracking-wide text-white transition-transform dark:text-coal hover:-translate-y-1">
          {ui.seeProjects}
        </a>
        <a href={profile.github} target="_blank" rel="noopener" class="flex items-center gap-2 border-2 border-ink px-5 py-3 font-display text-xl tracking-wide transition-colors hover:bg-ink hover:text-paper">
          <BrandIcon name="github" />GitHub
        </a>
        <a href="/cv-darwin-castano.pdf" target="_blank" rel="noopener" class="border-2 border-ink px-5 py-3 font-display text-xl tracking-wide transition-colors hover:bg-ink hover:text-paper">
          {ui.cv}
        </a>
      </div>
    </div>

    <div class="hero-photo-wrap relative mx-auto w-64 sm:w-72 md:w-[22rem]">
      <!-- Desfase de impresión: dos tintas detrás de la foto -->
      <div class="plate-cyan absolute inset-0 translate-x-2.5 translate-y-2.5 bg-cyan"></div>
      <div class="plate-pink absolute inset-0 -translate-x-2.5 -translate-y-2.5 bg-pink"></div>
      <img src={`${profile.avatar}&s=640`} alt={ui.photoAlt} width="352" height="352" class="hero-photo relative aspect-square w-full border-2 border-ink object-cover grayscale contrast-125" />
      <span class="burst absolute -top-6 -right-6 rotate-12 border-2 border-coal bg-yellow px-3 py-1 font-display text-2xl text-coal">DEPLOY!</span>
    </div>
  </div>

  <a href="#about" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-1 font-label text-xs tracking-[0.35em] text-muted uppercase transition-colors hover:text-red sm:flex">
    {ui.scroll}
    <span aria-hidden="true" class="scroll-hint text-2xl leading-none tracking-normal">↓</span>
  </a>
</section>
