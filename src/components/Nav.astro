---
import { getContent, getLang } from '../data/profile';
const { ui } = getContent(Astro.currentLocale);
const ids = ['about', 'experience', 'projects', 'skills', 'soft', 'contact'];
const other = getLang(Astro.currentLocale) === 'es' ? '/en/' : '/';
---
<nav class="fixed inset-x-0 top-0 z-50 border-b border-line bg-paper/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="#home" aria-label="Darwin Castaño" class="group">
      <img src="/logo.webp" alt="" width="40" height="40" class="size-10 rounded-md border-2 border-ink transition-transform group-hover:-rotate-6" />
    </a>
    <ul class="hidden gap-6 font-label text-base whitespace-nowrap lg:flex">
      {ids.map((id, i) => (
        <li><a href={`#${id}`} data-nav-link class="transition-colors hover:text-red">{ui.nav[i]}</a></li>
      ))}
    </ul>
    <div class="flex items-center gap-3">
      <button type="button" data-theme-toggle aria-label={ui.themeLabel} title={ui.themeLabel} class="grid size-9 place-items-center border-2 border-ink transition-colors hover:bg-ink hover:text-paper">
        <!-- Luna en claro, sol en oscuro: muestra el tema al que vas -->
        <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <a href={other} hreflang={other === '/' ? 'es' : 'en'} title={ui.switchTitle} aria-label={ui.switchTitle} class="text-3xl leading-none transition-transform hover:scale-110">
        {ui.switchLabel}
      </a>
      <a href="#contact" class="bg-red px-3 py-1 font-display text-lg tracking-wide text-white transition-transform hover:-translate-y-0.5 dark:text-coal">{ui.talk}</a>
    </div>
  </div>
</nav>

<script>
  // Tema elegido por el usuario, guardado en localStorage (el valor inicial lo pone Layout.astro).
  const root = document.documentElement;
  document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const apply = () => {
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
    };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reduced) return apply();
    // El tema nuevo se "imprime" en círculo desde el botón, a saltos como el resto de la página.
    // Centro del botón: funciona igual con ratón que con teclado.
    const box = btn.getBoundingClientRect();
    const x = box.left + box.width / 2;
    const y = box.top + box.height / 2;
    const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    document.startViewTransition(apply).ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
        { duration: 500, easing: 'steps(8)', pseudoElement: '::view-transition-new(root)' },
      );
    });
  });
</script>
