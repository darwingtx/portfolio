---
import SpiderWeb from './SpiderWeb.astro';
import SectionTitle from './SectionTitle.astro';
import { getContent } from '../data/profile';
const { profile, ui } = getContent(Astro.currentLocale);
---
<section id="about" class="relative mx-auto max-w-6xl px-4 py-24">
  <SpiderWeb class="section-web absolute -z-10 max-w-none -top-10 right-0 w-[30rem] translate-x-1/2 text-blood/40" seed={11} spokes={11} rings={6} />
  <SpiderWeb class="section-web absolute -z-10 max-w-none bottom-0 left-0 w-44 -translate-x-1/3 text-steel/45" size={300} seed={61} spokes={8} rings={4} />
  <SectionTitle kicker={ui.kickers.about} title={ui.titles.about} />
  <div class="grid gap-8 md:grid-cols-2">
    <div class="reveal comic-panel bg-[linear-gradient(135deg,var(--color-ink)_35%,var(--color-night))] p-8">
      <p class="text-lg leading-relaxed" set:html={profile.about} />
      <p class="mt-4 text-paper/70">{profile.aboutExtra}</p>
    </div>
    <ul class="reveal grid grid-cols-2 gap-4">
      {profile.interests.map((it, i) => (
        <li class={`flex items-center justify-center p-6 text-center font-display text-2xl tracking-wide text-ink ${['bg-pink', 'bg-cyan', 'bg-yellow', 'bg-violet text-paper'][i % 4]}`}>
          {it}
        </li>
      ))}
    </ul>
  </div>
</section>
