---
import SectionTitle from './SectionTitle.astro';
import SpiderWeb from './SpiderWeb.astro';
import { getContent } from '../data/profile';
const { profile, ui } = getContent(Astro.currentLocale);
---
<section id="about" class="relative mx-auto max-w-6xl px-4 py-24">
  <SpiderWeb class="absolute -z-10 max-w-none -top-10 right-0 w-[26rem] translate-x-1/3 text-red/35" seed={11} spokes={11} rings={6} />
  <SectionTitle title={ui.titles.about} />
  <div class="reveal grid gap-10 md:grid-cols-[1.5fr_1fr]">
    <div class="max-w-[65ch] space-y-5 text-xl leading-relaxed">
      {profile.about.map((p, i) => <p class={i === 0 ? 'text-[1.375rem] font-bold' : ''} set:html={p} />)}
    </div>
    <ul class="flex flex-wrap content-start gap-3">
      {profile.interests.map((it) => (
        <li class="border-2 border-ink bg-card px-4 py-2 font-display text-xl tracking-wide">{it}</li>
      ))}
    </ul>
  </div>
</section>
